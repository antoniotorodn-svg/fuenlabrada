---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CalendlySection from '../components/CalendlySection.astro';
import BarrioTag from '../components/BarrioTag.astro';
import MaterialFormativo from '../components/MaterialFormativo.astro';
import CTABox from '../components/CTABox.astro';
import barriosData from '../data/barrios.json';
import serviciosData from '../data/servicios.json';

const faqItems = [
  {
    question: "¿Dónde se encuentra vuestra consulta de nutrición en Fuenlabrada?",
    answer: "Estamos en la Calle Venezuela 4, en Fuenlabrada. La entrada es por la parte trasera del edificio, que da directamente al parque. Es una ubicación tranquila, con zonas verdes alrededor y aparcamiento gratuito en la calle."
  },
  {
    question: "¿Quiénes forman el equipo de nutricionistas en Fuenlabrada?",
    answer: "El equipo de Fuenlabrada está compuesto por Adrián, Soraya y Cristina, tres dietistas-nutricionistas colegiados con amplia experiencia en cambio de hábitos, composición corporal, nutrición clínica y alimentación deportiva. Los tres forman parte de la red de nutricionista.io."
  },
  {
    question: "¿En qué consiste la primera visita con el nutricionista?",
    answer: "Adrián, Soraya o Cristina realizarán una valoración completa de tu situación: historial de salud, hábitos alimentarios, ritmo de vida y metas personales. En las siguientes 72 horas recibirás por email tu plan nutricional con menús semanales, recetas sencillas y tu lista de la compra."
  },
  {
    question: "¿Con qué frecuencia se hacen las revisiones nutricionales?",
    answer: "Programamos las revisiones cada 21 días aproximadamente. En cada una medimos tu evolución, resolvemos las dudas acumuladas y adaptamos tu plan según tus avances. Además, entre citas puedes contactarnos por WhatsApp sin ningún coste extra."
  },
  {
    question: "¿Cuáles son las tarifas del nutricionista en Fuenlabrada?",
    answer: "La primera consulta cuesta 50€ e incluye valoración completa, plan personalizado y material formativo. Las revisiones sueltas son de 40€ por sesión. El pack de 4 sesiones (primera + 3 revisiones) sale por 140€, lo que supone un ahorro de 30€. Aceptamos efectivo y tarjeta."
  },
  {
    question: "¿Necesitaré tomar suplementos o comprar productos especiales?",
    answer: "En absoluto. En nuestra consulta de Fuenlabrada trabajamos exclusivamente con alimentos reales que puedes encontrar en cualquier supermercado. Nada de batidos sustitutivos, barritas ni complementos innecesarios. Solo comida de verdad adaptada a tus gustos."
  },
  {
    question: "¿Qué horario tiene la consulta de nutrición en Fuenlabrada?",
    answer: "Abrimos de lunes a viernes en horario continuo de 9:00 a 20:30. Puedes pedir cita llamando o escribiendo por WhatsApp al 623 99 89 39, o directamente desde el calendario online de esta web."
  },
  {
    question: "¿Es posible hacer la consulta de nutrición online desde Fuenlabrada?",
    answer: "Sí. Además de la atención presencial en nuestro centro de Fuenlabrada, ofrecemos consultas online por videollamada con el mismo nivel de calidad y seguimiento. Es perfecta si tienes un horario complicado o prefieres la comodidad de tu casa."
  },
  {
    question: "¿Trabajáis con deportistas en la consulta de Fuenlabrada?",
    answer: "Por supuesto. Nuestro equipo tiene experiencia en nutrición deportiva aplicada a disciplinas como running, ciclismo, musculación, artes marciales, natación y deportes de equipo. Diseñamos estrategias nutricionales alineadas con tus ciclos de entrenamiento y competición."
  },
  {
    question: "¿Puedo acudir al nutricionista en Fuenlabrada si tengo alguna enfermedad?",
    answer: "Claro que sí. Atendemos pacientes con diabetes tipo 2, hipercolesterolemia, hipertensión, síndrome de ovario poliquístico, trastornos digestivos como SIBO o colon irritable, celiaquía, intolerancias alimentarias y alteraciones hormonales. Siempre coordinamos con tu médico cuando es necesario."
  }
];

const testimonials = [
  {
    quote: "Llegué sin saber organizar mis comidas y en pocas semanas ya tenía una rutina clara. Las recetas son tan fáciles que hasta mi hijo de 12 años cocina conmigo.",
    author: "Beatriz L.",
    rating: 5
  },
  {
    quote: "Lo mejor ha sido descubrir que se puede comer bien sin renunciar a nada. Ahora disfruto de los fines de semana sin la culpa de antes.",
    author: "Miguel A.",
    rating: 5
  },
  {
    quote: "Después de probar mil aplicaciones de dietas, ir al nutricionista en persona ha sido un cambio total. El trato humano no lo sustituye ninguna app.",
    author: "Patricia V.",
    rating: 5
  },
  {
    quote: "Trabajo a turnos rotativos y siempre pensé que era imposible comer bien con mis horarios. Me demostraron que no, y además he bajado 8 kilos.",
    author: "Óscar D.",
    rating: 5
  },
  {
    quote: "Tenía el colesterol por las nubes y en tres meses mis analíticas han mejorado muchísimo. Mi médico no se lo creía. Totalmente recomendable.",
    author: "Inmaculada G.",
    rating: 5
  },
  {
    quote: "Son muy cercanos y nunca te juzgan. Fui con mucha vergüenza y desde el primer minuto me sentí cómoda. Ojalá lo hubiera hecho años antes.",
    author: "Teresa N.",
    rating: 5
  },
  {
    quote: "He aprendido a leer etiquetas, a hacer la compra con criterio y a preparar menús semanales sin volverme loco. El material que te dan es oro puro.",
    author: "Raúl C.",
    rating: 5
  },
  {
    quote: "Vine buscando perder peso y me he llevado mucho más: energía, mejor descanso y una relación sana con la comida. Gracias de corazón al equipo.",
    author: "Silvia H.",
    rating: 5
  },
  {
    quote: "Llevaba años con problemas digestivos y ningún médico me hablaba de alimentación. Aquí encontré respuestas y sobre todo soluciones prácticas.",
    author: "Álvaro B.",
    rating: 5
  },
  {
    quote: "Mi marido y yo empezamos juntos y ha sido genial. Nos han enseñado a cocinar en pareja y ahora cenamos mejor que nunca. Totalmente vale la pena.",
    author: "Nuria y Marcos",
    rating: 5
  },
  {
    quote: "Soy runner y necesitaba ajustar mi alimentación a los entrenos. En dos meses he mejorado mis tiempos y me recupero mucho antes de las tiradas largas.",
    author: "Fernando P.",
    rating: 5
  },
  {
    quote: "Con la menopausia había ganado peso sin cambiar nada. Me explicaron qué estaba pasando en mi cuerpo y juntas encontramos la solución. Muy profesionales.",
    author: "Concha M.",
    rating: 5
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HealthBusiness",
  "name": "Nutricionista en Fuenlabrada — Adrián, Soraya y Cristina",
  "description": "Consulta de nutrición en Fuenlabrada. Dietistas-nutricionistas colegiados especializados en pérdida de peso, nutrición deportiva, salud digestiva y hormonal.",
  "url": "https://nutricionista.io",
  "telephone": "+34623998939",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calle Venezuela, 4",
    "addressLocality": "Fuenlabrada",
    "addressRegion": "Madrid",
    "postalCode": "28943",
    "addressCountry": "ES"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.2838,
    "longitude": -3.7948
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "20:30"
    }
  ],
  "priceRange": "40€ - 140€",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "38"
  }
};
---

<BaseLayout
  title="Nutricionista en Fuenlabrada | C/ Venezuela 4 · Primera consulta 50€"
  description="Dietistas-nutricionistas colegiados en Fuenlabrada. Planes de alimentación a medida para adelgazar, nutrición deportiva, patologías digestivas y hormonales. C/ Venezuela 4. Primera consulta 50€. Pide cita hoy."
  schema={faqSchema}
  canonical="/nutricionista-en-fuenlabrada"
>
  <Nav slot="nav" />

  <!-- Schema LocalBusiness -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- 1. HERO -->
  <Hero
    name="Nutricionista en Fuenlabrada"
    role="Empieza a cuidarte hoy"
    showVideo={true}
    location="C/ Venezuela 4 · Fuenlabrada"
    description=""
    benefits={[]}
  />

  <!-- Trust Strip -->
  <TrustStrip />

  <!-- 2. INTRO SEO -->
  <section class="section" id="nutricionista-fuenlabrada">
    <div class="container">
      <div class="seo-intro">
        <h2 class="section-title">Dietistas-nutricionistas en Fuenlabrada: un equipo a tu lado</h2>
        <div class="seo-intro__text">
          <p><strong>Somos Adrián, Soraya y Cristina.</strong> Formamos el equipo de nutrición de Fuenlabrada dentro de la red de nutricionista.io, presente también con consultas en <strong>Alcorcón, Leganés, Getafe y Móstoles.</strong> Compartimos un método consolidado durante más de 7 años de práctica profesional en el sur de Madrid.</p>
          <p>Si necesitas un <strong>nutricionista en Fuenlabrada</strong> que trabaje contigo de forma cercana, que adapte cada recomendación a tu vida real y que no desaparezca entre consultas, has llegado al lugar indicado. Aquí no existen las dietas genéricas ni los planes que acaban en un cajón.</p>
          <p>Nuestra filosofía se apoya en tres ideas claras: <strong>comida real</strong> (nada de sustitutivos, batidos ni productos milagro), <strong>formación continua</strong> (queremos que entiendas cada decisión alimentaria) y <strong>seguimiento permanente</strong> (estamos a un WhatsApp de distancia cualquier día de la semana).</p>
          <p style="font-weight: 700; color: var(--text);">Más abajo te explicamos paso a paso cómo trabajamos y qué puedes esperar de nosotros.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PROCESO -->
  <section class="section section--warm" id="proceso">
    <div class="container">
      <h2 class="section-title">Así trabajamos contigo</h2>
      <div class="proceso-grid">
        <div class="proceso-card">
          <div class="proceso-icon">📋</div>
          <h3>Valoración inicial</h3>
          <p>Nos sentamos contigo para conocer tu historia, tus hábitos y lo que esperas conseguir. Rellenamos juntos un cuestionario detallado y trazamos el camino más eficaz para tu caso.</p>
        </div>
        <div class="proceso-card">
          <div class="proceso-icon">📩</div>
          <h3>Tu plan en 72 horas</h3>
          <p>Después de la consulta, elaboramos tu plan nutricional completo y te lo enviamos por email. A partir de ese momento, puedes escribirnos siempre que lo necesites.</p>
        </div>
        <div class="proceso-card">
          <div class="proceso-icon">📊</div>
          <h3>Revisiones periódicas</h3>
          <p>Cada tres semanas nos vemos para analizar resultados, resolver dudas y afinar tu plan. Además, en cada revisión te entregamos material educativo nuevo para seguir aprendiendo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. PRECIOS -->
  <section class="section" id="precios">
    <div class="container">
      <h2 class="section-title">Tarifas del nutricionista en Fuenlabrada</h2>
      <p class="section-sub">Consulta nuestras opciones y elige la que mejor encaje contigo.</p>

      <div class="pricing-row">
        <!-- Sesión individual -->
        <div class="price-basic">
          <div class="price-basic-label">Sesión individual</div>
          <div class="price-basic-header">Primera consulta</div>
          <div class="price-basic-amount">50<span>€</span></div>
          <ul class="price-basic-list">
            <li>✓ Valoración nutricional completa</li>
            <li>✓ Plan de alimentación personalizado</li>
            <li>✓ Material formativo de apoyo</li>
          </ul>
          <div class="price-basic-revision">Revisiones sueltas: 40€/sesión</div>
          <a href="#reservar" class="price-basic-btn">PEDIR CITA</a>
        </div>

        <!-- Pack destacado -->
        <div class="price-pack">
          <div class="pack-badge-top">⭐ MÁS ELEGIDO — AHORRA 30€</div>
          <div class="pack-header">
            <h3>Pack: Primera + 3 Revisiones</h3>
            <p>La opción favorita de nuestros pacientes</p>
          </div>
          <div class="pack-price-row">
            <div class="pack-old-price">170€</div>
            <div class="pack-new-price">140<span>€</span></div>
          </div>
          <div class="pack-savings">Te ahorras 30€ frente a pagar cada sesión por separado</div>
          <ul class="pack-features">
            <li>4 sesiones completas incluidas</li>
            <li>Plan nutricional + actualizaciones</li>
            <li>Atención por WhatsApp entre citas</li>
            <li>Material formativo en cada revisión</li>
            <li>Compromiso real, mejores resultados</li>
          </ul>
          <a href="#reservar" class="pack-btn">PEDIR CITA</a>
        </div>
      </div>

      <!-- Nota parejas -->
      <div class="parejas-note">
        <p class="parejas-title">💑 <strong>Tarifa especial parejas:</strong> descuento del <strong>30% en revisiones</strong> cuando venís juntos</p>
        <p class="parejas-detail">Primera consulta pareja: 100€ · Revisión pareja: 55€ (30% dto) · Bono 4 consultas parejas: 220€ (Ahorro 45€)</p>
        <a href="#reservar" class="parejas-btn">Reservar cita para 2 personas</a>
      </div>
    </div>
  </section>

  <!-- 5. UBICACIÓN + MAPA -->
  <section class="section section--alt" id="ubicacion">
    <div class="container">
      <h2 class="section-title">¿Cómo llegar a nuestra consulta en Fuenlabrada?</h2>
      <div class="location-box">
        <div class="location-info">
          <div class="location-row">
            <span class="location-icon">📍</span>
            <div>
              <strong>Dirección</strong>
              <span>Calle Venezuela 4 (Parte trasera, da al parque), 28943 Fuenlabrada</span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">📞</span>
            <div>
              <strong>Teléfono</strong>
              <span><a href="tel:+34623998939">623 99 89 39</a></span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">💬</span>
            <div>
              <strong>WhatsApp</strong>
              <span><a href="https://wa.me/34623998939?text=Hola%2C%20quiero%20informarme%20sobre%20Fuenlabrada" target="_blank" rel="noopener">623 99 89 39</a></span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">🕐</span>
            <div>
              <strong>Horarios</strong>
              <span>De Lunes a Viernes de 9:00 a 20:30</span>
            </div>
          </div>
          <div class="location-row">
            <span class="location-icon">🅿️</span>
            <div>
              <strong>Acceso</strong>
              <span>Entrada por la parte trasera (junto al parque) · Aparcamiento gratuito en la calle</span>
            </div>
          </div>
          <div class="location-actions">
            <a href="tel:+34623998939" class="loc-btn loc-btn--primary">Llamar al 623 99 89 39</a>
            <a href="https://wa.me/34623998939?text=Hola%2C%20quiero%20informarme%20sobre%20Fuenlabrada" target="_blank" rel="noopener" class="loc-btn loc-btn--outline">Enviar WhatsApp</a>
          </div>
        </div>
        <div class="location-map">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3015.2!2d-3.7948!3d40.2838!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd4188a3e1d3c5f7%3A0xa1b2c3d4e5f60718!2sC.%20Venezuela%2C%204%2C%2028943%20Fuenlabrada!5e0!3m2!1ses!2ses!4v1710000000000!5m2!1ses!2ses"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Nutricionista en Fuenlabrada — C/ Venezuela 4"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. RESERVA CITA (Calendly con tabs) -->
  <CalendlySection />

  <!-- 7. FAQ -->
  <section class="section section--warm" id="faq">
    <div class="container">
      <h2 class="section-title">Preguntas frecuentes sobre el nutricionista en Fuenlabrada</h2>
      <p class="section-sub">Resolvemos las dudas más habituales antes de tu primera visita:</p>
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <!-- CTA intermedio -->
  <CTABox
    title="Da el primer paso hacia una alimentación mejor"
    description="Pide tu primera consulta con nuestro equipo de nutricionistas en Fuenlabrada. 50€, sin permanencia. Llama o escríbenos por WhatsApp al 623 99 89 39."
    ctaText="Reservar mi cita"
    ctaHref="#reservar"
    variant="trust"
  />

  <!-- 8. QUÉ NOS DIFERENCIA -->
  <section class="section section--alt" id="diferencia">
    <div class="container">
      <h2 class="section-title">¿Qué nos hace diferentes como nutricionistas en Fuenlabrada?</h2>
      <div class="diff-text">
        <p>Nutricionista.io arrancó en 2017 como un proyecto individual. Hoy <strong>somos más de 20 dietistas-nutricionistas</strong> con consultas presenciales por toda España, incluidas Fuenlabrada, Alcorcón, Leganés, Getafe y Móstoles.</p>
        <p>Estos años nos han servido para pulir un sistema de trabajo orientado a lo que funciona de verdad: <strong>planes basados en comida real, educación nutricional práctica y acompañamiento entre consultas.</strong> Sin pastillas, sin atajos, sin letra pequeña.</p>
        <p>Cuando acudes a nuestro nutricionista en Fuenlabrada no solo te llevas un menú semanal. Accedes a un ecosistema completo de recursos diseñados para que los resultados perduren:</p>
      </div>

      <!-- Tres pilares destacados -->
      <div class="pilares-grid">
        <div class="pilar-card">
          <div class="pilar-num">1</div>
          <h3>Dossiers formativos en cada cita</h3>
          <p>Documentos prácticos sobre lectura de etiquetas, gestión del hambre emocional, planificación de comidas, metabolismo y mucho más. Aprendes el porqué detrás de cada indicación.</p>
        </div>
        <div class="pilar-card">
          <div class="pilar-num">2</div>
          <h3>Área privada de Pacientes</h3>
          <p>Más de 110 recursos a tu disposición: vídeos explicativos, guías descargables, infografías, herramientas de cálculo y recetarios temáticos para que seas autónomo/a.</p>
        </div>
        <div class="pilar-card">
          <div class="pilar-num">3</div>
          <h3>Canal de WhatsApp</h3>
          <p>Recetas nuevas cada semana, recomendaciones de productos del supermercado, ideas rápidas para el día a día y contacto directo con tu nutricionista entre visitas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. MATERIAL FORMATIVO -->
  <section class="section" id="material">
    <div class="container">
      <h2 class="section-title">El material formativo que recibirás</h2>
      <p class="section-sub">En cada revisión con tu nutricionista en Fuenlabrada te entregamos un dossier nuevo. Temas como lectura de etiquetas, gestión del peso, metabolismo y adherencia:</p>
      <MaterialFormativo />
    </div>
  </section>

  <!-- 10. ¿PARA QUIÉN ES? -->
  <section class="section section--warm" id="para-quien">
    <div class="container">
      <h2 class="section-title">¿A quién va dirigido nuestro servicio de nutrición en Fuenlabrada?</h2>
      <p class="section-sub">Da igual tu punto de partida. Si te ves reflejado/a en alguno de estos perfiles, podemos echarte una mano:</p>
      <div class="para-quien-grid">
        <div class="para-quien-card">
          <span class="para-quien-icon">⚖️</span>
          <h3>Necesitas perder peso de forma definitiva</h3>
          <p>Has pasado por dietas de revista, restricciones absurdas y efecto rebote. Buscas un método realista que se adapte a tu vida y que no te obligue a dejar de disfrutar de la comida.</p>
        </div>
        <div class="para-quien-card">
          <span class="para-quien-icon">🏃</span>
          <h3>Entrenas y quieres sacarle más partido</h3>
          <p>Ya sea gimnasio, pádel, running, ciclismo o cualquier otra disciplina, tu alimentación puede marcar la diferencia entre estancarte y seguir progresando. Te ayudamos a optimizar cada comida.</p>
        </div>
        <div class="para-quien-card">
          <span class="para-quien-icon">🩺</span>
          <h3>Convives con una patología que requiere atención</h3>
          <p>Diabetes, colesterol elevado, tensión alta, SOP, SIBO, colon irritable, celiaquía o intolerancias alimentarias. La nutrición clínica es una herramienta terapéutica fundamental y sabemos utilizarla.</p>
        </div>
        <div class="para-quien-card">
          <span class="para-quien-icon">🔄</span>
          <h3>Simplemente quieres alimentarte mejor</h3>
          <p>No persigues un número en la báscula, pero sabes que tus hábitos tienen margen de mejora. Quieres organizarte, comer con más criterio y notar los beneficios en tu energía y bienestar general.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 11. TESTIMONIOS -->
  <section class="section section--alt" id="testimonios">
    <div class="container">
      <div class="testi-header">
        <span class="testi-stars-big">★★★★★</span>
        <h2 class="section-title">Opiniones de nuestros pacientes en Fuenlabrada</h2>
        <p class="section-sub">Algunas de las valoraciones que nos dejan. Puedes consultar más en nuestro perfil de Google.</p>
      </div>
      <div class="resenas-grid">
        {testimonials.map(testimonial => (
          <TestimonialCard
            quote={testimonial.quote}
            author={testimonial.author}
            rating={testimonial.rating}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- 12. SERVICIOS -->
  <section class="section" id="servicios">
    <div class="container">
      <h2 class="section-title">Servicios de nutrición en Fuenlabrada</h2>
      <p class="section-sub">Cada consulta se adapta a lo que tú necesitas. Estos son los principales ámbitos en los que trabajamos:</p>
      <div class="servicios-grid">
        {serviciosData.map(servicio => (
          <ServiceCard
            emoji={servicio.emoji}
            title={servicio.title}
            description={servicio.shortDesc}
            href={`/${servicio.slug}`}
          />
        ))}
        <ServiceCard
